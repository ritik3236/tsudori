# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Neon Console → your project → Connection string (pooled, for the app runtime)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# Direct (non-pooled) connection — used only by Prisma migrations (prisma migrate dev/deploy)
# Same credentials as above, but without the "-pooler" suffix in the host
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=verify-full"

# ─── Neon Auth (Better Auth) ─────────────────────────────────────────────────
# Neon Console → your project → Auth tab → Configuration → Base URL
NEON_AUTH_BASE_URL="https://your-project.neon.tech/auth"

# Signs the session cookie — generate with: openssl rand -base64 32
# Must be 32+ characters.
NEON_AUTH_COOKIE_SECRET="change-me-to-a-random-32-plus-char-string"

# ─── Bootstrap ────────────────────────────────────────────────────────────────
# First sign-in from this email is auto-promoted to platform super admin and
# institute admin of the seeded institute. One-time and idempotent.
BOOTSTRAP_ADMIN_EMAIL="you@example.com"
