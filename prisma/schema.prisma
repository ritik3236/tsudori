// Tsudori — Education Management Platform
// Schema is multi-tenant from day one: every tenant-owned row carries an
// `instituteId`, and all data access is scoped through that boundary
// (see src/lib/tenant.ts). RBAC is data-driven (Role + Permission tables) so
// new roles/permissions are added as data, never as code changes.
//
// Identity lives in the `neon_auth` schema, which is owned and managed by Neon
// Auth (Better Auth). We map its `user` table here (see model User) but DO NOT
// manage it with Prisma migrations — Neon Auth creates and maintains it. The
// `multiSchema` setup lets our `public` tables FK across to it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "neon_auth"]
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity, tenancy & access control
// ─────────────────────────────────────────────────────────────────────────────

/// The platform user, owned by Neon Auth (Better Auth) in the `neon_auth` schema.
/// Read-only from the app's perspective — rows are created by Neon Auth on
/// sign-up. We map it so domain data can FK to a stable identity. Platform
/// super-admin status is carried by Better Auth's `role` column (`"admin"`).
/// NOTE: managed by Neon Auth; never created/altered by Prisma migrations.
model User {
  id            String    @id @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  /// Better Auth admin-plugin role. `"admin"` == platform super admin.
  role          String?
  banned        Boolean?
  banReason     String?
  banExpires    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @db.Timestamptz(3)
  updatedAt     DateTime  @db.Timestamptz(3)

  memberships      Membership[]
  markedAttendance Attendance[] @relation("AttendanceMarkedBy")
  createdHolidays  Holiday[]    @relation("HolidayCreatedBy")
  recordedPayments FeePayment[] @relation("PaymentRecordedBy")
  grantedWaivers   FeeWaiver[]  @relation("WaiverBy")
  notes            Note[]          @relation("NoteAuthor")
  noteComments     NoteComment[]   @relation("NoteCommentAuthor")
  tickets          Ticket[]        @relation("TicketRequester")
  ticketComments   TicketComment[] @relation("TicketCommentAuthor")
  auditLogs        AuditLog[]      @relation("AuditActor")

  @@map("user")
  @@schema("neon_auth")
}

enum InstituteStatus {
  ACTIVE
  SUSPENDED

  @@schema("public")
}

/// The tenant. A single deployment can host many institutes; in v1 it usually
/// holds one, but the boundary exists so SaaS multi-tenancy needs no migration.
model Institute {
  id          String          @id @default(cuid())
  name        String
  /// Institute logo as a downscaled base64 data URL (no blob storage yet).
  logoUrl     String?
  slug        String          @unique
  email       String?
  phone       String?
  addressLine String?
  city        String?
  state       String?
  country     String          @default("India")
  currency    String          @default("INR")
  locale      String          @default("en-IN")
  timezone    String          @default("Asia/Kolkata")
  status      InstituteStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  memberships Membership[]
  roles       Role[]
  classes     Class[]
  students    Student[]
  attendance  Attendance[]
  holidays    Holiday[]
  payments    FeePayment[]
  waivers     FeeWaiver[]
  courses     Course[]
  enrollments Enrollment[]
  feeCharges  FeeCharge[]
  studentInstallments StudentInstallment[]
  notes       Note[]
  settings    Setting[]
  invitations Invitation[]
  tickets     Ticket[]
  auditLogs   AuditLog[]

  @@schema("public")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED

  @@schema("public")
}

/// A user's role within one institute. The (user, institute) pair is unique,
/// so a user holds exactly one role per institute they belong to.
model Membership {
  id          String           @id @default(cuid())
  userId      String           @db.Uuid
  instituteId String
  roleId      String
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id])

  @@unique([userId, instituteId])
  @@index([instituteId])
  @@index([roleId])
  @@schema("public")
}

/// A named bundle of permissions. `instituteId == null` marks a system template
/// role (e.g. seeded SUPER_ADMIN); institute-scoped roles can be customised per
/// tenant without affecting others.
model Role {
  id          String   @id @default(cuid())
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  instituteId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute   Institute?       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]

  @@unique([instituteId, key])
  @@index([instituteId])
  @@schema("public")
}

/// A pending invite for someone to join an institute with a role. The invitee
/// opens /invite/<token>, sets a password, and a membership is created. Lets
/// non-super-admins (member:manage) add members without the admin identity API.
model Invitation {
  id          String           @id @default(cuid())
  instituteId String
  email       String
  roleId      String
  token       String           @unique
  invitedById String           @db.Uuid
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id])

  @@index([instituteId])
  @@index([email])
  @@schema("public")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED

  @@schema("public")
}

/// A single capability, e.g. `student:create`. Grouped by `module` so the UI can
/// render permission matrices per feature area.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@schema("public")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Academic domain (V1)
// ─────────────────────────────────────────────────────────────────────────────

enum ClassStatus {
  ACTIVE
  INACTIVE

  @@schema("public")
}

/// A class/grade/batch. One class has many students.
model Class {
  id                String      @id @default(cuid())
  instituteId       String
  name              String
  section           String
  // Normalized identity (lower-cased, whitespace-stripped "name|section") that
  // makes uniqueness case- and space-insensitive: "Class 2"+"B" == "class2"+"b".
  // Kept in sync by normalizeClassKey() in src/features/classes/schema.ts.
  nameKey           String
  /// The course this batch runs — the single source of the class's monthly fee.
  courseId          String?
  status            ClassStatus @default(ACTIVE)
  // Per-class weekly-off override: a JSON array of Luxon weekdays (1=Mon..7=Sun),
  // or NULL to inherit the institute default (Setting "attendance.weeklyOff").
  // An explicit [] means the class has NO weekly off (a daily/weekend-only batch).
  weeklyOffOverride Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  institute Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course    Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  students  Student[]
  holidays  Holiday[]

  @@unique([instituteId, nameKey])
  @@index([instituteId])
  @@index([courseId])
  @@schema("public")
}

enum StudentStatus {
  ACTIVE
  ON_HOLD
  LEFT
  COMPLETED

  @@schema("public")
}

/// How a student's fees are billed. MONTHLY = the per-enrolment monthly accrual
/// (the default, unchanged). INSTALLMENT = a per-student fixed schedule
/// (StudentInstallment) that replaces monthly accrual entirely — a student is one
/// or the other, never mixed across courses.
enum BillingMode {
  MONTHLY
  INSTALLMENT

  @@schema("public")
}

model Student {
  id            String        @id @default(cuid())
  instituteId   String
  /// Human-facing student id, sequential per institute (assigned in the service
  /// layer within a transaction — Postgres can't auto-increment per-tenant).
  serialNo      Int
  rollNumber    String?
  fullName      String
  classId       String?
  guardianName  String?
  contactNumber String?
  email         String?
  /// Profile photo — a Vercel Blob URL (a small resized webp). Null → initials.
  photoUrl      String?
  admissionDate DateTime      @db.Timestamptz(3)
  status        StudentStatus @default(ACTIVE)
  /// MONTHLY (per-enrolment monthly accrual) or INSTALLMENT (a per-student
  /// StudentInstallment schedule that replaces monthly billing). See BillingMode.
  billingMode   BillingMode   @default(MONTHLY)
  notes         String?
  /// Soft-archive: archived students drop out of active lists but keep history.
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  institute  Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  class      Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  attendance  Attendance[]
  payments    FeePayment[]
  waivers     FeeWaiver[]
  enrollments  Enrollment[]
  feeCharges   FeeCharge[]
  installments StudentInstallment[]

  @@unique([instituteId, serialNo])
  @@index([instituteId, status])
  @@index([instituteId, classId])
  @@index([instituteId, fullName])
  @@schema("public")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE

  @@schema("public")
}

model Attendance {
  id          String           @id @default(cuid())
  instituteId String
  studentId   String
  date        DateTime         @db.Timestamptz(3)
  status      AttendanceStatus
  note        String?
  markedById  String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy  User?     @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  /// One record per student per day — prevents duplicate attendance.
  @@unique([studentId, date])
  @@index([instituteId, date])
  @@schema("public")
}

enum HolidayKind {
  /// A non-working day — closes the day (public/custom holiday, or a named off).
  OFF
  /// Forces a working day, overriding the weekly-off (e.g. extra class on Sunday).
  WORKING

  @@schema("public")
}

/// A dated ruling that overrides the weekly-off pattern for attendance. Scope is
/// institute-wide when `classId` is null, or a single class otherwise — the
/// class-specific row wins over the institute one. Resolution + precedence live
/// in src/lib/working-day.ts (most specific wins; OFF/WORKING beat the pattern).
model Holiday {
  id          String      @id @default(cuid())
  instituteId String
  classId     String?
  date        DateTime    @db.Timestamptz(3)
  kind        HolidayKind @default(OFF)
  name        String?
  createdById String?     @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  class     Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("HolidayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // One ruling per (institute, class, date). classId NULL = institute-wide; the
  // migration creates this index NULLS NOT DISTINCT so two institute-wide rows
  // can't collide on the same date.
  @@unique([instituteId, classId, date])
  @@index([instituteId, date])
  @@schema("public")
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER

  @@schema("public")
}

model FeePayment {
  id           String        @id @default(cuid())
  instituteId  String
  studentId    String
  /// Negative for a reversal row (a credit note against `reversalOf`). Balances are
  /// SUM(amount), so a reversal nets the original out without deleting history.
  amount       Decimal       @db.Decimal(10, 2)
  /// The fee period this payment is applied to (nullable for ad-hoc payments).
  periodMonth  Int?
  periodYear   Int?
  method       PaymentMethod @default(CASH)
  paidAt       DateTime      @default(now())
  /// Sequential receipt number per institute (assigned in the service layer).
  /// NULL for reversal rows — they aren't receipts and carry no number.
  receiptNo    Int?
  note         String?
  recordedById String?       @db.Uuid
  /// When set, this row reverses (fully or partly) the referenced payment.
  reversalOfId String?
  /// Ledger links (fee-charge architecture): the enrolment this payment is for,
  /// and the specific charge it pays. Nullable for legacy rows pre-migration.
  enrollmentId String?
  chargeId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  institute  Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User?        @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  reversalOf FeePayment?  @relation("FeeReversals", fields: [reversalOfId], references: [id], onDelete: Cascade)
  reversals  FeePayment[] @relation("FeeReversals")
  enrollment Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  charge     FeeCharge?   @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@unique([instituteId, receiptNo])
  @@index([instituteId, paidAt])
  @@index([studentId])
  @@index([reversalOfId])
  @@index([enrollmentId])
  @@index([chargeId])
  @@schema("public")
}

/// A concession applied to one student for one fee month. Reduces the amount due
/// without being cash collected — keeps reports honest (waived ≠ collected).
model FeeWaiver {
  id          String   @id @default(cuid())
  instituteId String
  studentId   String
  /// Negative for a reversal row (undoes a concession). Waived totals are
  /// SUM(amount), so a reversal nets the original out without deleting history.
  amount      Decimal  @db.Decimal(10, 2)
  periodMonth Int
  periodYear  Int
  reason      String?
  waivedById  String?  @db.Uuid
  /// When set, this row reverses the referenced waiver.
  reversalOfId String?
  /// Ledger links (fee-charge architecture): the enrolment + the specific charge
  /// this concession reduces. Nullable for legacy rows pre-migration.
  enrollmentId String?
  chargeId     String?
  createdAt   DateTime @default(now())

  institute  Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  waivedBy   User?       @relation("WaiverBy", fields: [waivedById], references: [id], onDelete: SetNull)
  reversalOf FeeWaiver?  @relation("WaiverReversals", fields: [reversalOfId], references: [id], onDelete: Cascade)
  reversals  FeeWaiver[] @relation("WaiverReversals")
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  charge     FeeCharge?  @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  @@index([instituteId, periodYear, periodMonth])
  @@index([studentId])
  @@index([reversalOfId])
  @@index([enrollmentId])
  @@index([chargeId])
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fee catalog & ledger (Course → Enrollment → FeeCharge)
//
// Billing is accrual-based: a Course defines the price (recurring tuition +
// one-time components), an Enrollment links a student to a course (with an
// optional per-student fee override), and FeeCharge rows are the immutable debit
// ledger. Outstanding = Σ charges − Σ payments − Σ waivers.
// ─────────────────────────────────────────────────────────────────────────────

enum CourseStatus {
  ACTIVE
  INACTIVE

  @@schema("public")
}

/// A course/program the institute offers: a recurring monthly tuition over a fixed
/// duration, plus optional one-time fee components (admission, exam, …). Assigned
/// to classes and to enrolments — the catalog that drives all fees.
model Course {
  id             String       @id @default(cuid())
  instituteId    String
  name           String
  /// Normalized name (lower-cased, whitespace-stripped) for case/space-insensitive
  /// uniqueness — kept in sync by normalizeCourseKey() in the course feature.
  nameKey        String
  durationMonths Int
  monthlyFee     Decimal      @db.Decimal(10, 2)
  status         CourseStatus @default(ACTIVE)
  /// A bundle packages other courses under one combined fee (billed as a single
  /// charge at this course's monthlyFee). Members are tracked via CourseBundleItem.
  isBundle       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  institute   Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  components  CourseFeeComponent[]
  classes     Class[]
  enrollments Enrollment[]
  bundleItems CourseBundleItem[]   @relation("BundleItems")
  memberOf    CourseBundleItem[]   @relation("MemberOf")

  @@unique([instituteId, nameKey])
  @@index([instituteId, status])
  @@schema("public")
}

/// Links a bundle course to a course it includes. Display/reference only — the
/// bundle's own monthlyFee is what bills.
model CourseBundleItem {
  id             String @id @default(cuid())
  bundleCourseId String
  memberCourseId String

  bundle Course @relation("BundleItems", fields: [bundleCourseId], references: [id], onDelete: Cascade)
  member Course @relation("MemberOf", fields: [memberCourseId], references: [id], onDelete: Cascade)

  @@unique([bundleCourseId, memberCourseId])
  @@index([bundleCourseId])
  @@index([memberCourseId])
  @@schema("public")
}

/// A one-time fee on a course (e.g. "Admission fee", "Exam fee"). Charged once per
/// enrolment, when a student enrols on the course.
model CourseFeeComponent {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@schema("public")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@schema("public")
}

/// A student's enrolment on a course — the billing relationship. A student may
/// hold several at once. `feeOverride` (when set) wins over the course's monthlyFee
/// (scholarship/custom rate); null inherits the course fee live.
model Enrollment {
  id          String           @id @default(cuid())
  instituteId String
  studentId   String
  courseId    String
  /// Billing anchor — the month tuition starts accruing (seeded from admissionDate).
  startDate   DateTime         @db.Timestamptz(3)
  /// A fixed monthly rate for this enrolment (scholarship/custom). Null → not a
  /// fixed override. At most one of feeOverride / discountPercent is set.
  feeOverride Decimal?         @db.Decimal(10, 2)
  /// Percent off the course fee (0–100) — the alternative scholarship form. Null →
  /// no percentage discount. effectiveFee = course.monthlyFee × (1 − pct/100).
  discountPercent Decimal?     @db.Decimal(5, 2)
  status      EnrollmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  institute Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  charges   FeeCharge[]
  payments  FeePayment[]
  waivers   FeeWaiver[]

  @@index([instituteId, studentId])
  @@index([courseId])
  @@schema("public")
}

enum ChargeType {
  TUITION
  ONE_TIME
  /// A student-level installment: a StudentInstallment plan row materialized as a
  /// due-dated charge. Replaces TUITION for INSTALLMENT-billed students.
  INSTALLMENT

  @@schema("public")
}

/// The debit side of the fee ledger: one immutable charge a student owes. TUITION
/// rows are one-per-month (deduped by the unique index); ONE_TIME rows are
/// admission/exam/etc. Balances net via Σ charges − Σ payments − Σ waivers.
model FeeCharge {
  id           String     @id @default(cuid())
  instituteId  String
  /// Null for INSTALLMENT charges (student-scoped, not tied to one enrolment);
  /// always set for TUITION and ONE_TIME.
  enrollmentId String?
  /// Denormalized from the enrolment for fast per-student ledger queries.
  studentId    String
  type         ChargeType @default(TUITION)
  /// For ONE_TIME charges: the label (e.g. "Admission fee"). For INSTALLMENT: the
  /// installment label. Null for tuition.
  label        String?
  /// The fee period (month it covers): set for TUITION and INSTALLMENT (the
  /// installment's due month); null for ONE_TIME.
  periodMonth  Int?
  periodYear   Int?
  amount       Decimal    @db.Decimal(10, 2)
  dueDate      DateTime   @db.Timestamptz(3)
  createdAt    DateTime   @default(now())
  /// Set for INSTALLMENT charges: the StudentInstallment plan row this materializes.
  /// Unique → re-minting the same plan row is a no-op, even when two installments
  /// fall in the same due month (the period-tuple unique can't dedupe those).
  studentInstallmentId String? @unique

  institute          Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  enrollment         Enrollment?         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student            Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentInstallment StudentInstallment? @relation(fields: [studentInstallmentId], references: [id], onDelete: SetNull)
  payments           FeePayment[]
  waivers            FeeWaiver[]

  @@unique([enrollmentId, type, periodYear, periodMonth])
  @@index([instituteId, studentId])
  @@index([instituteId, studentId, type])
  @@index([enrollmentId])
  @@schema("public")
}

/// One row of a student's installment schedule (INSTALLMENT-billed students only).
/// Editable while unpaid; materializes exactly one immutable INSTALLMENT FeeCharge
/// (via FeeCharge.studentInstallmentId). Replaces monthly accrual for the student.
model StudentInstallment {
  id          String   @id @default(cuid())
  instituteId String
  studentId   String
  /// 1-based order within the student's schedule.
  seq         Int
  dueDate     DateTime @db.Timestamptz(3)
  amount      Decimal  @db.Decimal(10, 2)
  label       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  charge    FeeCharge?

  @@unique([studentId, seq])
  @@index([instituteId, studentId])
  @@schema("public")
}

/// A shared, institute-wide note board. Any member can post; teachers and admins
/// reply on the same page — a lightweight place to raise questions, flag bugs, or
/// leave announcements. Flat (no threading) by design in V1.
enum NotePriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("public")
}

model Note {
  id          String       @id @default(cuid())
  instituteId String
  authorId    String?      @db.Uuid
  body        String
  priority    NotePriority @default(NORMAL)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  institute Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  author    User?         @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  comments  NoteComment[]

  @@index([instituteId, createdAt])
  @@schema("public")
}

/// A flat reply on a shared note. The note board is internal to the institute,
/// so there's no staff/requester distinction (unlike TicketComment) — every
/// member's reply is equal.
model NoteComment {
  id        String   @id @default(cuid())
  noteId    String
  authorId  String?  @db.Uuid
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note   Note  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author User? @relation("NoteCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([noteId, createdAt])
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Support tickets
// ─────────────────────────────────────────────────────────────────────────────

/// A product-support ticket. Any institute member files one (bug / feature
/// request / question / billing); it routes to the platform super admin, who sees
/// every institute's tickets in one queue and works them. Requesters see only
/// their own. A flat reply thread (TicketComment) carries the conversation.
/// Priority/Status/Category are their own enums (kept separate from NotePriority)
/// so ticket triage can evolve without touching the notes board.
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@schema("public")
}

enum TicketCategory {
  BUG
  FEATURE
  QUESTION
  BILLING
  OTHER

  @@schema("public")
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("public")
}

model Ticket {
  id          String         @id @default(cuid())
  instituteId String
  requesterId String?        @db.Uuid
  subject     String
  description String
  category    TicketCategory @default(QUESTION)
  priority    TicketPriority @default(NORMAL)
  status      TicketStatus   @default(OPEN)
  /// Set when status first reaches RESOLVED; cleared on reopen.
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  institute Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  requester User?           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  comments  TicketComment[]

  @@index([instituteId, createdAt])
  @@index([status, createdAt])
  @@schema("public")
}

model TicketComment {
  id            String   @id @default(cuid())
  ticketId      String
  authorId      String?  @db.Uuid
  body          String
  /// True when authored by the platform super admin (support). Stored, not
  /// derived, so it stays correct even if the author's user row is later nulled.
  authorIsStaff Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@schema("public")
}

/// Flexible per-institute key/value config for anything not worth a column yet.
model Setting {
  id          String   @id @default(cuid())
  instituteId String
  key         String
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, key])
  @@schema("public")
}

/// Append-only trail of sensitive mutations (reversals, member/role changes,
/// archive, waive). Written in-transaction from the service layer, so a log row
/// exists iff the change committed. `action` is a dotted string (see AUDIT_ACTIONS
/// in src/features/audit/service.ts); `metadata` holds readable context (amounts,
/// names, before/after) so the admin view needs no joins.
model AuditLog {
  id          String   @id @default(cuid())
  instituteId String
  actorId     String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  actor     User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([instituteId, createdAt])
  @@index([instituteId, entityType, entityId])
  @@index([instituteId, actorId])
  @@schema("public")
}
